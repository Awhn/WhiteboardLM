# WhiteboardLM 백엔드 환경변수 예시 (Cloud Run / 로컬)
# 실제 .env 파일은 커밋하지 마세요.

# Cloud Run이 자동 주입 — 로컬에서만 수동 지정 (기본 8080)
# PORT=8080

# --- CORS (프런트엔드 오리진 허용) ---
# 콤마로 구분된 정확한 오리진 목록. Cloudflare Pages 도메인을 넣으세요.
CORS_ALLOW_ORIGINS=http://localhost:5173,https://whiteboardlm.pages.dev
# 와일드카드(프리뷰 배포 등)용 정규식. 기본값이 모든 *.pages.dev를 허용합니다.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.pages\.dev

# --- 데이터베이스 (보드 영속화, 선택) ---
# 미설정 시 SQLite 폴백 → Cloud Run에선 비내구성(재시작 시 소실).
# 영속화하려면 무료 관리형 Postgres(Neon/Supabase 등) URL 지정:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- LLM (제로-시크릿 모드면 모두 생략 가능) ---
# 제로-시크릿 모드: 프런트엔드가 요청마다 X-LLM-Model / X-LLM-Api-Key 헤더로
# 모델·키를 전달하므로 서버에 키를 둘 필요가 없습니다(아래 키들 생략).
# LLM_MODEL=anthropic/claude-opus-4-8
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- 보안/한도 ---
# 코드 실행 도구(run_python)는 임의 파이썬 실행 → 기본 비활성(RCE 위험).
# 신뢰된 환경에서만 활성화하세요.
# ENABLE_RUN_PYTHON=false
# 도구 호출 루프 최대 반복 (기본 5)
# MAX_TOOL_ITERATIONS=5
# 요청 본문 최대 바이트 (기본 10MB)
# MAX_BODY_BYTES=10485760
